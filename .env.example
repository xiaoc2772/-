# 本地服务端口
APP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
NEXT_PUBLIC_BASE_URL=http://localhost:8080

# 本地认证与内部调用密钥。正式环境必须替换为独立的高强度随机值。
SESSION_SECRET=replace-with-a-random-session-secret-at-least-32-chars
INTERNAL_API_SECRET=replace-with-a-random-internal-secret-at-least-32-chars
RAFFLE_DELIVERY_CRON_SECRET=replace-with-a-random-cron-secret-at-least-32-chars
CRON_SECRET=replace-with-a-random-cron-secret-at-least-32-chars
ADMIN_USERNAMES=admin

# new-api 集成；留空时项目可以启动，但登录、直充、用户同步等能力不可用。
NEW_API_URL=
NEW_API_ADMIN_ACCESS_TOKEN=
NEW_API_ADMIN_USER_ID=
NEW_API_ADMIN_USERNAME=
NEW_API_ADMIN_PASSWORD=

# 可选对象存储；留空时反馈附件使用本地 Docker 数据卷。
R2_PUBLIC_URL=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_FEEDBACK_IMAGES=feedback-images
S3_BUCKET_CARD_IMAGES=card-images
FEEDBACK_MEDIA_PUBLIC_URL=

# 可选邮件通知。
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
FARM_MAIL_FROM=
